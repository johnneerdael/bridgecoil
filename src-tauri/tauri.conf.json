{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADB Studio",
  "version": "0.1.0",
  "identifier": "nl.neerdael.adbstudio.poc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ADB Studio \u00b7 POC",
        "width": 460,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "iOS": {
      "infoPlist": "Info.plist"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
