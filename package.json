{
  "name": "adb-studio-poc",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "tauri": "node scripts/tauri.mjs",
    "android": "node scripts/tauri.mjs android",
    "ios": "node scripts/tauri.mjs ios",
    "desktop": "node scripts/tauri.mjs dev",
    "build:desktop": "node scripts/tauri.mjs build --debug --bundles app",
    "test:rust": "node scripts/cargo.mjs test --workspace",
    "lint:rust": "node scripts/cargo.mjs clippy --workspace --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
